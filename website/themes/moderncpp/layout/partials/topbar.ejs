<%
  var ui = mcpp_ui(page);
  var isIndex = mcpp_is_index(page);
  var chapter = mcpp_chapter(page.title);
%>
<header class="topbar">
  <% if (!isIndex) { %>
  <button class="menu-btn" type="button" aria-label="<%- ui.menu %>" aria-controls="sidebar" aria-expanded="false"><span></span></button>
  <% } %>
  <a class="brand" href="<%- url_for(ui.home) %>">
    <img src="<%- url_for('/modern-cpp/' + ui.logo) %>" alt="" width="20" height="26">
    <span><%- ui.site %></span>
  </a>
  <div class="crumbs">
    <% if (!isIndex && page.title) { %>
      <span class="crumbs-sep" aria-hidden="true">/</span>
      <% if (chapter.label) { %><span class="crumbs-label"><%- chapter.label %></span><% } %>
      <span class="crumbs-name"><%- chapter.name %></span>
    <% } %>
  </div>
  <nav class="topbar-tools">
    <a class="tool tool-text" href="<%- url_for('/modern-cpp/' + ui.pdfFile) %>" title="<%- ui.downloadPdf %>">
      <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true"><path d="M10 3v9m0 0-3.5-3.5M10 12l3.5-3.5M4 15.5h12" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
      <span><%- ui.pdf %></span>
    </a>
    <a class="tool tool-text tool-lang" href="<%- url_for(mcpp_other_href(page)) %>" hreflang="<%- ui.otherPref === 'zh' ? 'zh-CN' : 'en' %>" title="<%- ui.otherTitle %>" onclick="try{localStorage.setItem('mcpp-lang','<%- ui.otherPref %>')}catch(e){}"><%- ui.other %></a>
    <a class="tool" href="<%- mcpp_repo() %>" aria-label="GitHub" title="GitHub">
      <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg>
    </a>
  </nav>
</header>
