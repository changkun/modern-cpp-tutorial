<% var ui = mcpp_ui(page); %>
<aside id="sidebar" class="sidebar" aria-label="<%- ui.contents %>">
  <div class="nav-head"><%- ui.contents %></div>
  <ol class="nav-list">
    <% mcpp_pages(ui.bookType).forEach(function (p) { var c = mcpp_chapter(p.title); %>
      <li><a href="<%- url_for(p.path).replace(/index\.html$/, '') %>"<%- p.path === page.path ? ' aria-current="page"' : '' %>><span class="nav-num"><%- c.num %></span><span class="nav-title"><%- c.name %></span></a></li>
    <% }) %>
  </ol>
  <div class="nav-head"><%- ui.about %></div>
  <ol class="nav-list nav-about">
    <% mcpp_pages(ui.aboutType).forEach(function (p) { %>
      <li><a href="<%- url_for(p.path) %>"<%- p.path === page.path ? ' aria-current="page"' : '' %>><span class="nav-num"></span><span class="nav-title"><%- p.title %></span></a></li>
    <% }) %>
  </ol>
  <div class="nav-downloads">
    <a href="<%- url_for('/modern-cpp/' + ui.pdfFile) %>"><%- ui.pdf %></a>
    <a href="<%- url_for('/modern-cpp/' + ui.epubFile) %>"><%- ui.epub %></a>
    <a href="<%- mcpp_repo() %>">GitHub</a>
  </div>
</aside>
