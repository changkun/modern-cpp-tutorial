<%
  var ui = mcpp_ui(page);
  var chapters = mcpp_pages(ui.bookType);
  var first = chapters[0];
  var href = function (p) { return url_for(p.path).replace(/index\.html$/, ''); };
%>
<main id="content" class="landing">
  <section class="hero">
    <div class="hero-inner">
      <div class="hero-text">
        <p class="hero-eyebrow"><span><%- ui.byline %></span><span class="hero-edition"><%- ui.edition %></span></p>
        <h1><%- ui.site %></h1>
        <p class="hero-tagline"><%- ui.tagline %></p>
        <p class="hero-blurb"><%- ui.blurb %></p>
        <div class="hero-actions">
          <% if (first) { %><a class="btn btn-primary" href="<%- href(first) %>"><%- ui.start %> <span aria-hidden="true">→</span></a><% } %>
          <a class="btn btn-ghost" href="<%- url_for('/modern-cpp/' + ui.pdfFile) %>"><%- ui.downloadPdf %></a>
        </div>
        <p class="hero-links">
          <a href="<%- url_for('/modern-cpp/' + ui.epubFile) %>"><%- ui.epub %></a>
          <a href="<%- mcpp_repo() %>">GitHub</a>
          <a href="<%- url_for(mcpp_other_href(page)) %>" hreflang="<%- ui.otherPref === 'zh' ? 'zh-CN' : 'en' %>" onclick="try{localStorage.setItem('mcpp-lang','<%- ui.otherPref %>')}catch(e){}"><%- ui.otherTitle %></a>
        </p>
      </div>
      <div class="hero-cover">
        <img src="<%- url_for('/modern-cpp/' + ui.cover) %>" alt="<%- ui.coverAlt %>" width="720" height="944">
      </div>
    </div>
  </section>

  <section class="contents" aria-labelledby="contents-title">
    <h2 id="contents-title"><%- ui.contents %></h2>
    <ol class="chapter-grid">
      <% chapters.forEach(function (p) { var c = mcpp_chapter(p.title); %>
        <li>
          <a href="<%- href(p) %>">
            <span class="cg-num"><%- c.num %></span>
            <span class="cg-text">
              <% if (c.label) { %><span class="cg-label"><%- c.label %></span><% } %>
              <span class="cg-name"><%- c.name %></span>
            </span>
          </a>
        </li>
      <% }) %>
    </ol>
  </section>

  <div class="landing-footer"><%- partial('partials/footer') %></div>
</main>
